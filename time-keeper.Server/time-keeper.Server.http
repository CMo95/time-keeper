@time_keeper.Server_HostAddress = https://localhost:49454


// DEMO CONTENT
GET {{time_keeper.Server_HostAddress}}/weatherforecast
Accept: application/json

###


// EARLY AUTH(API TESTING NOT SECURE)
POST {{time_keeper.Server_HostAddress}}/token
Content-Type: application/json
{"username":"TestUser","password":"TestPassword1!"}

###


// REGISTER NEW USER
POST {{time_keeper.Server_HostAddress}}/api/auth/register
Content-Type: application/json
{"username":"TestUser","password":"TestPassword1!"}

###


// LOGIN
POST {{time_keeper.Server_HostAddress}}/api/auth/login
Content-Type: application/json
{"username":"TestUser","password":"TestPassword1!"}

###


//REFRESH USER TOKENS
POST {{time_keeper.Server_HostAddress}}/api/auth/refresh
Content-Type: application/json
{"refreshToken": "6c85b6a7-c82e-422a-9d69-a46cce203246"}

###


// REVOKE USER TOKENS(Logout)
POST {{time_keeper.Server_HostAddress}}/api/auth/revoke
Content-Type: application/json
{"refreshToken": "8456b7d4-2af6-48dc-b037-5bf91bf81076"}

###


